prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavformat
Description: FFmpeg container format library
Version: 62.12.102
Requires: 
Requires.private: libavcodec >= 62.28.102, libswresample >= 6.3.102, libavutil >= 60.26.102
Conflicts:
Libs: "-L${libdir}" -lavformat
Libs.private: "-L${prefix}/lib" -lz -lsecur32 -lncrypt -lcrypt32 -lws2_32
Cflags: "-I${includedir}"

